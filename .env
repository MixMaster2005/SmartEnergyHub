# ============================================================
# SmartEnergy Hub - Configuration centralisée (ENF-02)
# Aucune donnée sensible réelle : identifiants de développement local.
# Variables consommées par docker-compose.yml et les application.yml.
# ============================================================

# --- Redis (requis) ---
REDIS_PASSWORD=change-me
REDIS_PORT=6379

# --- Cassandra ---
# "datacenter1" = valeur de l'image officielle Cassandra (obligatoire pour le storage).
CASSANDRA_PORT=9042
CASSANDRA_DC=datacenter1
CASSANDRA_MAX_HEAP=512M
CASSANDRA_HEAP_NEWSIZE=128M

# --- MongoDB (mots de passe requis) ---
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=root_dev
MONGO_SENSOR_PASSWORD=change-me-sensor
MONGO_ANALYTICS_PASSWORD=change-me-analytics
MONGO_PORT=27017

# --- Simulateur (profil "tools") ---
# SIMULATOR_SENSORS est un NOMBRE de capteurs (pas une liste).
SIMULATOR_SENSORS=5
SIMULATOR_INTERVAL=PT2S
SIMULATOR_DURATION=PT2M

# --- Analytics (optionnel) ---
ANALYTICS_FORECAST_ENABLED=false
