# ============================================================
# SmartEnergy Hub - Configuration (ENF-02)
# Copier vers .env :  cp .env.example .env
# Ce fichier ne contient que des PLACEHOLDERS. Ne jamais committer
# un .env contenant des secrets reels.
# Les valeurs ci-dessous sont les defauts de development.
# ============================================================

# --- Redis (requis par docker-compose.yml) ---
REDIS_PASSWORD=change-me
REDIS_PORT=6379

# --- Cassandra ---
# CASSANDRA_DC doit rester "datacenter1" (image officielle Cassandra).
CASSANDRA_PORT=9042
CASSANDRA_DC=datacenter1
CASSANDRA_MAX_HEAP=512M
CASSANDRA_HEAP_NEWSIZE=128M

# --- MongoDB (mots de passe requis par docker-compose.yml) ---
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=change-me-root
MONGO_SENSOR_PASSWORD=change-me-sensor
MONGO_ANALYTICS_PASSWORD=change-me-analytics
MONGO_PORT=27017

# --- Simulateur (profil "tools", optionnel) ---
# SIMULATOR_SENSORS est un NOMBRE de capteurs (pas une liste).
SIMULATOR_SENSORS=5
SIMULATOR_INTERVAL=PT2S
SIMULATOR_DURATION=PT2M

# --- Analytics (optionnel) ---
# Drapeau de l'extension de prevision IA (endpoint /forecast -> 501 si false).
ANALYTICS_FORECAST_ENABLED=false
